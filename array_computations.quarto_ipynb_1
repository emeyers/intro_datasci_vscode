    "#| echo: false\n",
    "\n",
    "H, W = 420, 420\n",
    "canvas = np.zeros((H, W, 3))\n",
    "yy, xx = np.mgrid[0:H, 0:W]\n",
    "\n",
    "\n",
    "def circle_mask(cx, cy, r):\n",
    "    return (xx - cx) ** 2 + (yy - cy) ** 2 <= r ** 2\n",
    "\n",
    "\n",
    "r = 130\n",
    "red_center = (210, 150)\n",
    "green_center = (150, 270)\n",
    "blue_center = (270, 270)\n",
    "\n",
    "# Add light into each channel wherever its circle covers a pixel; where circles\n",
    "# overlap, the added light combines (and is clipped at 255, full intensity).\n",
    "canvas[circle_mask(*red_center, r), 0] += 255\n",
    "canvas[circle_mask(*green_center, r), 1] += 255\n",
    "canvas[circle_mask(*blue_center, r), 2] += 255\n",
    "canvas = np.clip(canvas, 0, 255).astype(\"uint8\")\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(6, 6))\n",
    "ax.imshow(canvas)\n",
    "ax.axis(\"off\")\n",
    "ax.set_title(\"Mixing red, green, and blue light (additive color)\", fontsize=12)\n",
    "\n",
    "ax.text(210, 60, \"Red\", ha=\"center\", va=\"center\", fontsize=12, fontweight=\"bold\", color=\"white\")\n",
