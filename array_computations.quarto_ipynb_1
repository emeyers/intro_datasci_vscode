       "width": 574
      }
     },
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Load the image into a NumPy array (same imread as above; the file is stored locally)\n",
    "peppers = imread(\"images/peppers.jpg\")\n",
    "\n",
    "plt.imshow(peppers)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 62,
   "id": "d50bff5a",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "[(648, 960, 3), dtype('uint8')]"
      ]
     },
     "execution_count": 62,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "[peppers.shape, peppers.dtype]"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a456995f",
