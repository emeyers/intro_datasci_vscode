     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "# The week in which the largest change occurred.\n",
    "# We add 1 because each change belongs to the *later* of the two weeks it spans.\n",
    "gas_dates[np.argmax(np.abs(weekly_changes)) + 1]"
   ]
  },
