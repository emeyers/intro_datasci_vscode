.ipynb_checkpoints
*/.ipynb_checkpoints/*

# render artifacts, all regenerated by `quarto render`. The published site is
# built from source by .github/workflows/publish.yml, so none of this needs to
# be committed.
/.quarto/
/_manuscript
/_book/
/_freeze/
/*_files/

/agujournal2019.cls
/trackchanges.sty

/.luarc.json

# ignore local data files, but keep committed snapshots used as render-time
# fallbacks (e.g. the gas-price data, in case FRED is unreachable in CI)
data/*
!data/gas_prices_GASREGW_2025.csv
# the baby-name dataset is built here and served from this repo, so both the
# generated files and the script that generates them are tracked
!data/babynames/

.env
# quarto leaves both `foo.quarto_ipynb` and numbered `foo.quarto_ipynb_1` copies
**/*.quarto_ipynb*
